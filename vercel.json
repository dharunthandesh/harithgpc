{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "harithgpc.in"
        }
      ],
      "destination": "https://www.harithgpc.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "harithgpc.com"
        }
      ],
      "destination": "https://www.harithgpc.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.harithgpc.com"
        }
      ],
      "destination": "https://www.harithgpc.in/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product-catalog",
      "destination": "/Product_Catalog",
      "permanent": true
    },
    {
      "source": "/product-catalog-print",
      "destination": "/Product_Catalog_print",
      "permanent": true
    }
  ]
}
