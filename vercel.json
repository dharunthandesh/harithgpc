{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product-catalog",
      "destination": "/Product_Catalog",
      "permanent": true
    },
    {
      "source": "/product-catalog-print",
      "destination": "/Product_Catalog_print",
      "permanent": true
    }
  ]
}
